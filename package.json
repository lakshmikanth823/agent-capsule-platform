{
  "name": "capsule-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Secure infrastructure platform for agent-built small software",
  "workspaces": [
    "packages/*",
    "services/edge-proxy",
    "services/egress-proxy",
    "services/builder",
    "apps/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "prebuild": "npm run --workspace=@capsule/manifest-schema --if-present build",
    "build": "node scripts/build.js",
    "test": "npm run test:ts && npm run test:py",
    "test:ts": "vitest run",
    "test:redteam": "vitest run tests/redteam/redteam.test.ts",
    "test:py": "node scripts/run-python.js -m pytest services/control-plane/tests",
    "lint": "node scripts/lint.js && npm run --workspaces --if-present lint",
    "format": "prettier --write \"**/*.{ts,js,json,md,yaml,yml}\"",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "db:migrate": "node scripts/run-python.js -m alembic -c services/control-plane/alembic.ini upgrade head",
    "db:seed": "node scripts/run-python.js services/control-plane/src/db/seed.py",
    "db:reset": "node scripts/run-python.js services/control-plane/src/db/reset.py",
    "control-plane:dev": "node scripts/run-python.js -m uvicorn --app-dir services/control-plane/src main:app --port 8000 --reload"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
