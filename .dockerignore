docs/

# CI/CD
.github/

# Deploy directory (compose/monitoring not needed inside containers)
deploy/compose/
deploy/monitoring/
deploy/systemd/

# Data directories
data/
.capsule/

# IDE / OS
.vscode
.idea
**/.DS_Store
Thumbs.db

# Examples (not needed in production images)
examples/
