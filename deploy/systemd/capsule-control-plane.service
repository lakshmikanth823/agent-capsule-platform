[Unit]
Description=Capsule Platform — Control Plane
Documentation=https://github.com/your-org/capsule-platform/blob/main/docs/RUNBOOK.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10

# Location of the compose file
WorkingDirectory=/opt/capsule

# Environment file supplies non-secret config (AWS_REGION, ECR_REGISTRY, IMAGE_TAG, etc.)
# This file contains NO secrets — those are fetched from AWS Secrets Manager at runtime.
EnvironmentFile=/opt/capsule/env.conf

ExecStartPre=/usr/bin/docker compose -f /opt/capsule/deploy/compose/docker-compose.control-plane.yml pull
ExecStart=/usr/bin/docker compose -f /opt/capsule/deploy/compose/docker-compose.control-plane.yml up --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/capsule/deploy/compose/docker-compose.control-plane.yml down --timeout 30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=capsule-control-plane

[Install]
WantedBy=multi-user.target
