# ==============================================================================
# Software Capsule Platform - Environment Configuration Example
# Copy this file to .env for local development.
# Never commit .env with real secrets to version control.
# ==============================================================================

# Platform Environment (development | staging | production)
NODE_ENV=development
PLATFORM_ENV=development

# Control Plane API (Python / FastAPI)
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8000
DATABASE_URL=postgresql+asyncpg://capsule_user:capsule_dev_password@localhost:5432/capsule_control

# Authentication & Identity
# Options: mock | oidc
AUTH_PROVIDER=mock
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=mock-client-id
OIDC_AUDIENCE=capsule-platform
JWT_SIGNING_SECRET=dev-only-jwt-secret-do-not-use-in-prod

# Storage Driver
# Options: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.capsule/storage
# S3 / MinIO configuration (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=capsule-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Edge Proxy
EDGE_HOST=127.0.0.1
EDGE_PORT=8080
APP_BASE_DOMAIN=localhost
DASHBOARD_URL=http://localhost:8080

# Sandbox Driver
# Options: docker | mock
SANDBOX_DRIVER=docker
DOCKER_NETWORK=capsule-network
